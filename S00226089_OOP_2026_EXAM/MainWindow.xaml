<Window x:Class="S00226089_OOP_2026_EXAM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:S00226089_OOP_2026_EXAM"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="35*"/>
            <ColumnDefinition Width="35*"/>
            <ColumnDefinition Width="30*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height=" 20*"/>
            <RowDefinition Height=" 70*"/>
            <RowDefinition Height=" 10*"/>
        </Grid.RowDefinitions>
        <Button Content="Charge" Click="btnCharge_Click" Margin=" 5" Grid.Row="2" Grid.Column="2"/>
        <TextBlock Text="Filter" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Grid.Column="0" Grid.Row="0"/>
        <TextBlock Text="Robot List" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Grid.Column="1" Grid.Row="0"/>
        <TextBlock Text="Robot Details" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Grid.Column="2" Grid.Row="0"/>
        <ListBox x:Name="lstAllRobots" Grid.Row="1" Grid.Column="1" Margin="5" SelectionChanged="lstAllRobots_SelectionChanged"/>
    </Grid>
</Window>
